Panels:
- Class: rviz/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Displays:
  - Class: rviz/Grid
    Name: Grid
    Enabled: true
    Plane Cell Count: 30
    Cell Size: 1
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 2.9000000953674316
      Min Value: 0
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 178; 178; 206
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Name: simulation_map
    Position Transformer: XYZ
    Queue Size: 10
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.10000000149011612
    Style: Boxes
    Topic: /map_generator/global_cloud
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Class: rviz/MarkerArray
    Enabled: true
    Marker Topic: /map_generator/wall_geometry
    Name: wall_geometry
    Namespaces: {}
    Queue Size: 2
    Value: true
  - Class: rviz/MarkerArray
    Name: Eight UAVs and bounded trails
    Enabled: true
    Marker Topic: /fixed_wall_benchmark/markers
    Queue Size: 1
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz_plugins/Goal3DTool
    Topic: /goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 20.134401321411133
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: -4.7901082038879395
        Y: -0.6352322697639465
        Z: 0.8174818158149719
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.4149998426437378
      Target Frame: world
      Yaw: 3.1349985599517822
Window Geometry:
  Width: 1200
  Height: 800
